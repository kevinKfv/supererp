# ==============================================================================
# OptimusAI / SuperERP - Environment Variables Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE RUNNING IN PRODUCTION.
# NEVER COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL (Criterio G6 - OWASP).

# General Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication (Identity Service)
SECRET_KEY=dev-only-secret-key-change-in-production-must-be-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_DEFAULT_USER=admin_supererp
ADMIN_DEFAULT_PASSWORD=SuperSecretPassword123!
ADMIN_DEFAULT_EMAIL=admin@supererp.com

# PostgreSQL Database
POSTGRES_USER=optimus
POSTGRES_PASSWORD=optimus_password
POSTGRES_DB=optimus_identity
DATABASE_URL=postgresql://optimus:optimus_password@postgres:5432/optimus_identity

# Redis & Celery Broker
REDIS_URL=redis://redis:6379/0

# MinIO Object Storage
MINIO_URL=minio:9000
MINIO_ROOT_USER=optimus_admin
MINIO_ROOT_PASSWORD=optimus_password
MINIO_ACCESS_KEY=optimus_admin
MINIO_SECRET_KEY=optimus_password

# Gateway & Service Discovery URLs
GATEWAY_PORT=8000
FRONTEND_PORT=5173
IDENTITY_SERVICE_URL=http://identity-service:8000
OPTIMIZATION_ENGINE_URL=http://optimization-engine:8000
PREDICTION_ENGINE_URL=http://prediction-engine:8000
SIMULATION_ENGINE_URL=http://simulation-engine:8000
RULES_ENGINE_URL=http://rules-engine:8000
KNOWLEDGE_ENGINE_URL=http://knowledge-engine:8000
MOCK_EXTERNAL_SERVICE_URL=http://mock-external-service:8000

